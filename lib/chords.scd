// Chord shapes: name -> semitone intervals above the root.
// Intervals adapted from Tidal Cycles (Sound.Tidal.Chords, GPL-3.0).
//
// Feed a shape as a pitch sequence value; the pitch scalar is the root. An array
// in \pitch voices every note at once (SC multichannel expansion), e.g.
//   pitch: Pseq([~chords[\min7], ~chords[\maj]], inf).asStream   // scalar = root

~chords = (
	major:             [0, 4, 7],
	aug:               [0, 4, 8],
	six:               [0, 4, 7, 9],
	sixNine:           [0, 4, 7, 9, 14],
	major7:            [0, 4, 7, 11],
	major9:            [0, 4, 7, 11, 14],
	add9:              [0, 4, 7, 14],
	major11:           [0, 4, 7, 11, 14, 17],
	add11:             [0, 4, 7, 17],
	major13:           [0, 4, 7, 11, 14, 21],
	add13:             [0, 4, 7, 21],
	dom7:              [0, 4, 7, 10],
	dom9:              [0, 4, 7, 14],
	dom11:             [0, 4, 7, 17],
	dom13:             [0, 4, 7, 21],
	sevenFlat5:        [0, 4, 6, 10],
	sevenSharp5:       [0, 4, 8, 10],
	sevenFlat9:        [0, 4, 7, 10, 13],
	nine:              [0, 4, 7, 10, 14],
	eleven:            [0, 4, 7, 10, 14, 17],
	thirteen:          [0, 4, 7, 10, 14, 17, 21],
	minor:             [0, 3, 7],
	diminished:        [0, 3, 6],
	minorSharp5:       [0, 3, 8],
	minor6:            [0, 3, 7, 9],
	minorSixNine:      [0, 3, 9, 7, 14],
	minor7flat5:       [0, 3, 6, 10],
	minor7:            [0, 3, 7, 10],
	minor7sharp5:      [0, 3, 8, 10],
	minor7flat9:       [0, 3, 7, 10, 13],
	minor7sharp9:      [0, 3, 7, 10, 15],
	diminished7:       [0, 3, 6, 9],
	minor9:            [0, 3, 7, 10, 14],
	minor11:           [0, 3, 7, 10, 14, 17],
	minor13:           [0, 3, 7, 10, 14, 17, 21],
	minorMajor7:       [0, 3, 7, 11],
	one:               [0],
	five:              [0, 7],
	sus2:              [0, 2, 7],
	sus4:              [0, 5, 7],
	sevenSus2:         [0, 2, 7, 10],
	sevenSus4:         [0, 5, 7, 10],
	nineSus4:          [0, 5, 7, 10, 14],
	sevenFlat10:       [0, 4, 7, 10, 15],
	nineSharp5:        [0, 1, 13],
	minor9sharp5:      [0, 1, 14],
	sevenSharp5flat9:  [0, 4, 8, 10, 13],
	minor7sharp5flat9: [0, 3, 8, 10, 13],
	elevenSharp:       [0, 4, 7, 10, 14, 18],
	minor11sharp:      [0, 3, 7, 10, 14, 18]
);

// Short names alias the canonical shapes.
[
	[\maj, \major], [\M, \major],
	[\plus, \aug], [\sharp5, \aug],
	['6', \six],
	[\six9, \sixNine], [\sixby9, \sixNine], ['6by9', \sixNine],
	[\maj7, \major7], [\M7, \major7],
	[\maj9, \major9], [\M9, \major9],
	[\maj11, \major11], [\M11, \major11],
	[\maj13, \major13], [\M13, \major13],
	['7f5', \sevenFlat5],
	['7s5', \sevenSharp5],
	['7f9', \sevenFlat9],
	['11', \eleven],
	['13', \thirteen],
	[\min, \minor], [\m, \minor],
	[\dim, \diminished],
	[\msharp5, \minorSharp5], [\mS5, \minorSharp5],
	[\min6, \minor6], [\m6, \minor6],
	[\minor69, \minorSixNine], [\min69, \minorSixNine], [\minSixNine, \minorSixNine],
	[\m69, \minorSixNine], [\mSixNine, \minorSixNine], [\m6by9, \minorSixNine],
	[\minor7f5, \minor7flat5], [\min7flat5, \minor7flat5], [\min7f5, \minor7flat5],
	[\m7flat5, \minor7flat5], [\m7f5, \minor7flat5],
	[\min7, \minor7], [\m7, \minor7],
	[\minor7s5, \minor7sharp5], [\min7sharp5, \minor7sharp5], [\min7s5, \minor7sharp5],
	[\m7sharp5, \minor7sharp5], [\m7s5, \minor7sharp5],
	[\minor7f9, \minor7flat9], [\min7flat9, \minor7flat9], [\min7f9, \minor7flat9],
	[\m7flat9, \minor7flat9], [\m7f9, \minor7flat9],
	[\minor7s9, \minor7sharp9], [\min7sharp9, \minor7sharp9], [\min7s9, \minor7sharp9],
	[\m7sharp9, \minor7sharp9], [\m7s9, \minor7sharp9],
	[\dim7, \diminished7],
	[\min9, \minor9], [\m9, \minor9],
	[\min11, \minor11], [\m11, \minor11],
	[\min13, \minor13], [\m13, \minor13],
	[\minMaj7, \minorMajor7], [\mmaj7, \minorMajor7],
	['1', \one],
	['5', \five],
	['7sus2', \sevenSus2],
	['7sus4', \sevenSus4],
	[\ninesus4, \nineSus4], ['9sus4', \nineSus4],
	['7f10', \sevenFlat10],
	['9sharp5', \nineSharp5], ['9s5', \nineSharp5],
	[\minor9s5, \minor9sharp5], [\min9sharp5, \minor9sharp5], [\min9s5, \minor9sharp5],
	[\m9sharp5, \minor9sharp5], [\m9s5, \minor9sharp5],
	['7s5f9', \sevenSharp5flat9],
	[\m7sharp5flat9, \minor7sharp5flat9],
	['11s', \elevenSharp],
	[\m11sharp, \minor11sharp], [\m11s, \minor11sharp]
].do { |a| ~chords[a[0]] = ~chords[a[1]] };
